#!/usr/bin/env python3
"""Claude Code PreToolUse hook (matcher: Bash). Exit 2 refuses commands that
skip or weaken the checks, force-push, push straight to the default branch,
or merge / post statuses / change protection outside `ship`."""
import json
import re
import shlex
import subprocess
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
cmd = (data.get("tool_input") or {}).get("command") or ""
cwd = data.get("cwd") or None


def deny(why):
    print(f"Blocked by CI guard: {why}", file=sys.stderr)
    sys.exit(2)


if "--no-verify" in cmd:
    deny("--no-verify skips the hooks. Fix the failure instead.")
if re.search(r"\bLEFTHOOK(_EXCLUDE)?=", cmd):
    deny("LEFTHOOK/LEFTHOOK_EXCLUDE turns hooks off. Fix the failure instead.")
if "core.hooksPath" in cmd or re.search(r"\blefthook\s+uninstall\b", cmd):
    deny("changing or removing git hooks is Cohen's call.")
if re.search(r"\bgh\s+pr\s+merge\b", cmd):
    deny("merge only through `ship` (it checks the exact commit first).")
if re.search(r"\bgh\s+api\b", cmd) and re.search(
    r"/statuses/|/merges\b|/pulls/\d+/merge|/protection\b", cmd
):
    deny("statuses, merges and branch protection go through ship / ci-status / ci-protect.")


def default_branch():
    try:
        ref = subprocess.run(
            ["git", "symbolic-ref", "--short", "-q", "refs/remotes/origin/HEAD"],
            cwd=cwd, capture_output=True, text=True, timeout=5,
        ).stdout.strip()
        return ref.split("/", 1)[1] if "/" in ref else "main"
    except Exception:
        return "main"


def current_branch():
    try:
        return subprocess.run(
            ["git", "symbolic-ref", "--short", "-q", "HEAD"],
            cwd=cwd, capture_output=True, text=True, timeout=5,
        ).stdout.strip()
    except Exception:
        return ""


for seg in re.split(r"&&|\|\||;|\|", cmd):
    try:
        t = shlex.split(seg)
    except ValueError:
        t = seg.split()
    while t and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", t[0]):
        t = t[1:]
    if len(t) < 2 or t[0] != "git":
        continue
    # skip git global options like -C dir
    i = 1
    while i < len(t) and t[i].startswith("-"):
        i += 2 if t[i] in ("-C", "-c") else 1
    if i >= len(t):
        continue
    sub, args = t[i], t[i + 1:]
    if sub == "commit":
        prev = ""
        for a in args:
            if prev in ("-m", "-F", "-c", "-C", "--message", "--file"):
                prev = ""
                continue
            if a.startswith("-") and not a.startswith("--") and "n" in a[1:]:
                deny("`git commit -n` skips the pre-commit hook.")
            prev = a
    if sub == "push":
        if any(a in ("-f", "--force", "--force-with-lease", "--force-if-includes") or a.startswith("--force")
               or (a.startswith("-") and not a.startswith("--") and "f" in a[1:]) for a in args):
            deny("no force pushes.")
        if any(a.startswith("+") for a in args):
            deny("`+refspec` is a force push.")
        main = default_branch()
        targets = [a.split(":")[-1] for a in args if not a.startswith("-")][1:]
        if not targets:
            if current_branch() in (main, "main", "master"):
                deny(f"direct push to {main}. Work on a branch and use `ship`.")
        elif any(x in (main, "main", "master", f"refs/heads/{main}") for x in targets):
            deny(f"direct push to {main}. Work on a branch and use `ship`.")
sys.exit(0)
