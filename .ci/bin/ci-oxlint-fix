#!/usr/bin/env bash
# ci-oxlint-fix [--dir pkg] '<verify command>'
# Applies oxlint's autofixes one rule at a time, most hits first. After each
# rule it runs the verify command (e.g. 'just typecheck && just unit'); a rule
# whose fixes break it is reverted and listed. Fixes are never applied blind:
# even oxlint's "safe" fixes can change types (e.g. dropping an `as const`).
# Run on a clean tree; leaves the kept fixes staged and commits nothing.
# Fixes land in every linted file, so the verify command should exercise all of
# them; ignore (in .oxlintrc) or revert fixes in folders nothing tests.
set -uo pipefail
dir=.
[[ "${1:-}" == "--dir" ]] && { dir="$2"; shift 2; }
verify="${1:?usage: ci-oxlint-fix '<verify command>'}"
root="$(git rev-parse --show-toplevel)"; cd "$root/$dir" || exit 2
[[ -z "$(git status --porcelain --untracked-files=no)" ]] || { echo "ci-oxlint-fix: commit or set aside tracked changes first" >&2; exit 2; }
config=.oxlintrc.jsonc; [[ -f $config ]] || config=.oxlintrc.json
bash -c "$verify" >/dev/null 2>&1 || { echo "ci-oxlint-fix: verify fails before any fix; fix that first" >&2; exit 2; }
rules="$(npx --no-install oxlint --type-aware -c "$config" -f json . 2>/dev/null \
  | bun -e 'const d=JSON.parse(await Bun.stdin.text()).diagnostics;const c={};for(const x of d)c[x.code]=(c[x.code]??0)+1;for(const [k,v] of Object.entries(c).sort((a,b)=>b[1]-a[1]))console.log(k)')"
kept=() dropped=()
for code in $rules; do
  # "eslint(curly)" -> "eslint/curly"
  rule="${code%%(*}/${code#*(}"; rule="${rule%)}"
  npx --no-install oxlint --type-aware -c "$config" -A all -D "$rule" --fix . >/dev/null 2>&1
  git diff --quiet && continue   # nothing fixable (kept fixes are staged)
  if bash -c "$verify" >/dev/null 2>&1; then
    kept+=("$rule"); git add -u
  else
    dropped+=("$rule"); git diff --name-only --relative -z | xargs -0 git checkout -q --
  fi
done
echo "ci-oxlint-fix: applied ${#kept[@]} rule(s): ${kept[*]:-none}"
echo "ci-oxlint-fix: reverted ${#dropped[@]} rule(s) whose fixes broke verify: ${dropped[*]:-none}"
