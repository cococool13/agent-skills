#!/usr/bin/env bash
# ci-taste [ref]   (default v1, the tag the old design-guard workflow callers used)
# Runs design-guard's taste-guard.sh at that release on the current repo.
# The release is exported (git archive) into ~/.cache/ci/design-guard/<sha>, so
# whatever branch the local Design Guard checkout is on never changes results.
# taste-guard scans with --no-ignore (a fresh CI checkout has no ignored files),
# so it runs on a copy of the files git would commit: tracked plus untracked
# but not ignored. Local data such as node_modules or state/ never trips it.
set -euo pipefail
ref="${1:-${DESIGN_GUARD_REF:-v1}}"
src="${DESIGN_GUARD:-$HOME/Projects/Design Guard}"
if ! sha="$(git -C "$src" rev-parse -q --verify "$ref^{commit}")"; then
  git -C "$src" fetch -q --tags origin
  sha="$(git -C "$src" rev-parse --verify "$ref^{commit}")"
fi
dir="${XDG_CACHE_HOME:-$HOME/.cache}/ci/design-guard/$sha"
if [[ ! -x "$dir/taste-guard.sh" ]]; then
  mkdir -p "$dir.tmp"
  git -C "$src" archive "$sha" | tar -x -C "$dir.tmp"
  mv "$dir.tmp" "$dir"
fi
root="$(git rev-parse --show-toplevel)"
scan="$(mktemp -d "${TMPDIR:-/tmp}/ci-taste.XXXXXX")"
trap 'rm -rf "$scan"' EXIT
(cd "$root" && git ls-files -z --cached --others --exclude-standard \
  | while IFS= read -r -d '' f; do [[ -e "$f" || -L "$f" ]] && printf '%s\0' "$f"; done \
  | tar --null -T - -cf -) | tar -x -C "$scan"
bash "$dir/taste-guard.sh" "$scan"
