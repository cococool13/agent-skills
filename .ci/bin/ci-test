#!/usr/bin/env bun
// ci-test <vitest|node|bun> [--dir pkg] [--full] [--shards N] [--files <glob>]... [--exclude <glob>]... [-- runner args...]
//
// Runs a repo's unit tests the fast way:
// 1. Diff-only on PRs. When CI_BASE is set (ci-check sets it for any commit not
//    on the default branch), only test files whose static import closure reaches
//    a changed file run. Anything it cannot be sure about (a changed config,
//    lockfile, fixture or non-JS file, an import it cannot resolve that is not a
//    declared dependency, e.g. a path alias) runs all. Main and the nightly run
//    everything. --full always runs everything (tests that reach the code through
//    a spawned server rather than an import).
// 2. Cores filled by recorded time. Each test file's last duration is kept in
//    ~/.cache/ci/timings/<repo>/<runner>.json and files start longest-first.
//    node/bun: one process per file across --shards N lanes (default: cores).
//    vitest: one process; its pool already fills cores longest-first, and
//    splitting it into several processes measured slower (8.6s vs 16.0s).
// --dir runs from a package subdirectory (worker/, server/): its node_modules,
// its config; --files globs are relative to it.
// --exclude drops files from that list (globs relative to --dir).
// --files defaults to every tracked JS/TS *.test.* / *.spec.* outside e2e/ and node_modules.
// Runner args after `--` go to every shard (e.g. -- --import tsx).
import { $ } from "bun";
import { builtinModules } from "node:module";
import { cpus, tmpdir } from "node:os";
import { existsSync, mkdirSync, mkdtempSync, readFileSync, writeFileSync } from "node:fs";
import { dirname, extname, join, resolve } from "node:path";

const argv = process.argv.slice(2);
const runner = argv.shift();
if (!runner || !["vitest", "node", "bun"].includes(runner)) {
  console.error("usage: ci-test <vitest|node|bun> [--dir pkg] [--full] [--shards N] [--files glob]... [--exclude glob]... [-- args]");
  process.exit(2);
}
let shardsWanted = 0;
let dir = ".";
let full = false;
const globs: string[] = [];
const excludes: string[] = [];
let extra: string[] = [];
for (let i = 0; i < argv.length; i++) {
  if (argv[i] === "--shards") shardsWanted = Number(argv[++i]);
  else if (argv[i] === "--dir") dir = argv[++i];
  else if (argv[i] === "--full") full = true;
  else if (argv[i] === "--files") globs.push(argv[++i]);
  else if (argv[i] === "--exclude") excludes.push(argv[++i]);
  else if (argv[i] === "--") { extra = argv.slice(i + 1); break; }
  else { console.error(`ci-test: unknown option ${argv[i]}`); process.exit(2); }
}

const root = (await $`git rev-parse --show-toplevel`.text()).trim();
const cwd = resolve(root, dir);
process.chdir(cwd);
const pathspecs = globs.length ? globs.map((g) => `:(glob)${g}`) : [
  ":(glob)**/*.test.*", ":(glob)**/*.spec.*",
  ":(exclude,glob)**/e2e/**", ":(exclude,glob)**/node_modules/**",
];
for (const g of excludes) pathspecs.push(`:(exclude,glob)${g}`);
const testExt = /\.(test|spec)\.[cm]?[jt]sx?$/; // the default list skips *.test.sh and the like
let files = (await $`git ls-files -- ${pathspecs}`.text()).split("\n")
  .filter((f) => f && existsSync(f) && (globs.length > 0 || testExt.test(f)));
const all = files.length;

// ---------- 1. diff-only ----------
const scannable = new Set([".ts", ".tsx", ".mts", ".cts", ".js", ".jsx", ".mjs", ".cjs"]);
function affected(changed: Set<string>): string[] | "ALL" {
  for (const f of changed) {
    if (f.endsWith(".md")) continue;
    // Configs and setup files shape every test without being imported by one.
    if (/(^|[.\-_])(config|setup|teardown|globalsetup|global-setup)([.\-_]|$)/i.test(f.split("/").pop()!)) {
      console.log(`ci-test: ${f.slice(root.length + 1)} changed and is a config or setup file; running every test`);
      return "ALL";
    }
    if (!scannable.has(extname(f))) {
      console.log(`ci-test: ${f.slice(root.length + 1)} changed and is not a JS/TS module; running every test`);
      return "ALL";
    }
  }
  const deps0 = new Set<string>();
  for (const pj of (Bun.spawnSync(["git", "ls-files", "--", ":(glob)**/package.json", "package.json"], { cwd: root }).stdout.toString().split("\n").filter(Boolean))) {
    try {
      const j = JSON.parse(readFileSync(join(root, pj), "utf8"));
      for (const k of ["dependencies", "devDependencies", "peerDependencies", "optionalDependencies"]) for (const n of Object.keys(j[k] ?? {})) deps0.add(n);
      if (j.name) deps0.add(j.name);
    } catch {}
  }
  const declared = (pkg: string) => deps0.has(pkg);
  const configs = Bun.spawnSync(["git", "ls-files", "--", ":(glob)**/*.config.*", ":(glob)*.config.*"], { cwd: root }).stdout.toString().split("\n").filter(Boolean)
    .map((f) => { try { return readFileSync(join(root, f), "utf8"); } catch { return ""; } }).join("\n");
  const aliased = (spec: string) => configs.includes(spec);
  const memo = new Map<string, string[]>();
  const deps = (file: string): string[] => {
    let d = memo.get(file);
    if (d) return d;
    d = [];
    memo.set(file, d);
    if (!scannable.has(extname(file)) || !existsSync(file)) return d;
    const e = extname(file);
    const loader = e === ".tsx" ? "tsx" : e === ".jsx" ? "jsx" : /^\.[mc]?ts$/.test(e) ? "ts" : "js";
    for (const raw of new Bun.Transpiler({ loader }).scanImports(readFileSync(file, "utf8").replace(/^#!.*/, ""))) {
      const path = raw.path.replace(/\?.*$/, ""); // ../x.jsonc?raw
      if (/^(node|bun):/.test(path) || builtinModules.includes(path)) continue;
      let r: string;
      try { r = Bun.resolveSync(path, dirname(file)); } catch {
        const where = file.slice(root.length + 1);
        if (/^[./]/.test(path)) throw new Error(`cannot resolve ${path} from ${where}`);
        if (/^[a-z]+:/.test(path)) {
          // A runtime module (cloudflare:workers). Fine unless a config aliases it to repo code.
          if (aliased(path)) throw new Error(`${path} in ${where} is aliased in a config`);
          continue;
        }
        const pkg = path.startsWith("@") ? path.split("/").slice(0, 2).join("/") : path.split("/")[0];
        if (declared(pkg)) continue; // a dependency that is not installed here is not repo code
        throw new Error(`cannot resolve ${path} from ${where} (a path alias?)`);
      }
      if (!r.includes("/node_modules/") && r.startsWith(root + "/")) d.push(r);
    }
    return d;
  };
  try {
    return files.filter((t) => {
      const start = resolve(cwd, t), seen = new Set([start]), stack = [start];
      while (stack.length) {
        const f = stack.pop()!;
        if (changed.has(f)) return true;
        for (const n of deps(f)) if (!seen.has(n)) { seen.add(n); stack.push(n); }
      }
      return false;
    });
  } catch (e) {
    console.log(`ci-test: ${(e as Error).message}; running every test`);
    return "ALL";
  }
}
const base = process.env.CI_BASE;
if (base && full) console.log("ci-test: --full; running every test");
if (base && !full) {
  const out = await $`git diff --name-only ${base} -- . && git diff --name-only HEAD -- . && git ls-files --others --exclude-standard`.text();
  const changed = new Set(out.split("\n").filter(Boolean).map((f) => resolve(root, f)));
  const pick = affected(changed);
  if (pick !== "ALL") {
    files = pick;
    console.log(`ci-test: diff from ${base.slice(0, 9)} reaches ${files.length} of ${all} test files`);
    if (!files.length) process.exit(0);
  }
}

// ---------- 2. fill the cores by recorded time ----------
const slug = (await $`git remote get-url origin`.nothrow().text()).trim()
  .replace(/.*github\.com[:/]/, "").replace(/\.git$/, "").replace("/", "__") || root.split("/").pop()!;
const pkgKey = dir === "." ? "" : `${dir.replace(/[^A-Za-z0-9._-]/g, "_")}-`;
const store = join(process.env.XDG_CACHE_HOME ?? join(process.env.HOME!, ".cache"), "ci", "timings", slug, `${pkgKey}${runner}.json`);
const times: Record<string, number> = existsSync(store) ? JSON.parse(readFileSync(store, "utf8")) : {};
const known = files.map((f) => times[f]).filter((t) => t != null).sort((a, b) => a - b);
const guess = known.length ? known[Math.floor(known.length / 2)] : 1;
const cost = (f: string) => times[f] ?? guess;
const queue = [...files].sort((a, b) => cost(b) - cost(a)); // longest first
const measured: Record<string, number> = {};
const started = performance.now();
const failures: string[] = [];
const run = async (cmd: string[]) => {
  const p = Bun.spawn(cmd, { stdout: "pipe", stderr: "pipe" });
  const out = (await new Response(p.stdout).text()) + (await new Response(p.stderr).text());
  return { ok: (await p.exited) === 0, out };
};

let lanes = 1;
if (runner === "vitest") {
  // One process: vitest's own worker pool already runs files on every core,
  // longest-recorded-first (its results cache). Several vitest processes measured slower.
  const tmp = mkdtempSync(join(tmpdir(), "ci-test-"));
  const json = join(tmp, "vitest.json");
  // --no-install: the repo's pinned vitest or nothing, never a cached or downloaded one.
  const r = await run(["npx", "--no-install", "vitest", "run", "--reporter=default", "--reporter=json",
    `--outputFile.json=${json}`, ...extra, ...queue]);
  if (existsSync(json)) {
    for (const t of JSON.parse(readFileSync(json, "utf8")).testResults ?? []) {
      const rel = String(t.name).startsWith(cwd + "/") ? String(t.name).slice(cwd.length + 1) : String(t.name);
      // File wall time, or the sum of its tests when vitest reports no file span.
      const span = t.endTime && t.startTime ? t.endTime - t.startTime : 0;
      const sum = (t.assertionResults ?? []).reduce((a: number, x: { duration?: number }) => a + (x.duration ?? 0), 0);
      measured[rel] = Math.max(span, sum) / 1000;
    }
  }
  process.stdout.write(r.out.split("\n").slice(r.ok ? -8 : -120).join("\n") + "\n");
  if (!r.ok) failures.push("vitest");
} else {
  // node / bun: a pool of one process per file, as many lanes as cores, each
  // lane taking the longest file left. Every file gets its own measured time.
  lanes = Math.max(1, Math.min(queue.length, shardsWanted || cpus().length));
  let next = 0;
  await Promise.all(Array.from({ length: lanes }, async () => {
    while (next < queue.length) {
      const f = queue[next++];
      const t = performance.now();
      const cmd = runner === "node" ? ["node", "--test", ...extra, f] : ["bun", "test", ...extra, `./${f}`];
      const r = await run(cmd);
      measured[f] = (performance.now() - t) / 1000;
      if (!r.ok) {
        failures.push(f);
        console.log(`----- FAIL ${f} -----\n$ ${cmd.join(" ")}\n${r.out.split("\n").slice(-60).join("\n")}`);
      }
    }
  }));
}
const wall = (performance.now() - started) / 1000;
mkdirSync(dirname(store), { recursive: true });
// Re-read before writing: parallel recipes using the same runner share this file.
const latest = existsSync(store) ? JSON.parse(readFileSync(store, "utf8")) : {};
const tmpStore = `${store}.${process.pid}`;
writeFileSync(tmpStore, JSON.stringify({ ...latest, ...measured }));
await $`mv ${tmpStore} ${store}`;
const slowest = Object.entries(measured).sort((a, b) => b[1] - a[1]).slice(0, 3)
  .map(([f, t]) => `${f} ${t.toFixed(1)}s`).join(", ");
console.log(`ci-test: ${files.length} files, ${lanes} lane(s), ${wall.toFixed(1)}s wall; slowest: ${slowest}`);
if (failures.length) console.log(`ci-test: FAILED ${failures.join(" ")}`);
const failed = failures.length;
process.exit(failed ? 1 : 0);
