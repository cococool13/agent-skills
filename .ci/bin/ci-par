#!/usr/bin/env bash
# ci-par [--pre r1,r2] recipe...
# Runs `just <recipe>` for every recipe at once, one log each, then prints a
# timing table. On failure: the failing log tail, the first error line it can
# find (file:line when there is one) and the exact rerun command.
# --pre recipes run first, one at a time (dependency installs).
# A stage that exits 0 after printing `ci-skip: <reason>` is marked skipped.
# A stage whose status file is missing or malformed fails (fail closed).
# Runs under macOS /bin/bash 3.2: no EPOCHREALTIME, no empty "${a[@]}" under set -u.
set -uo pipefail

pre=()
if [[ "${1:-}" == "--pre" ]]; then
  IFS=, read -ra pre <<<"$2"
  shift 2
fi
[[ $# -gt 0 ]] || { echo "usage: ci-par [--pre a,b] recipe..." >&2; exit 2; }

logs="$(mktemp -d "${TMPDIR:-/tmp}/ci-par.XXXXXX")" || exit 1
trap 'rm -rf "$logs"' EXIT
: >"$logs/started" || exit 1
# EPOCHREALTIME is bash 5; macOS /bin/bash 3.2 (hooks from GUI apps, minimal PATHs)
# falls back to whole seconds. A comma decimal (some locales) would break bc.
now() { if [[ -n "${EPOCHREALTIME:-}" ]]; then echo "${EPOCHREALTIME/,/.}"; else date +%s; fi; }
start=$(now)

table=""
for r in ${pre[@]+"${pre[@]}"}; do
  s=$(now)
  if ! just "$r" >"$logs/pre-$r.log" 2>&1; then
    echo "----- $r (last 40 lines) -----" >&2
    tail -n 40 "$logs/pre-$r.log" >&2
    echo "rerun: just $r" >&2
    exit 1
  fi
  table+="$(LC_ALL=C printf 'ok    %-22s %6.1fs  (first, alone)' "$r" "$(bc <<<"$(now) - $s")")"$'\n'
done

pids=()
for r in "$@"; do
  (
    s=$(now)
    just "$r" >"$logs/$r.log" 2>&1
    rc=$?
    elapsed="$(bc <<<"$(now) - $s")" || exit 1
    LC_ALL=C printf '%s %.1f\n' "$rc" "$elapsed" >"$logs/$r.rc"
  ) &
  pids+=("$!")
done

first_error() {
  # file:line first, then the usual failure words.
  grep -m1 -E '[A-Za-z0-9_./-]+\.[A-Za-z]{1,6}:[0-9]+' "$1" \
    || grep -m1 -iE '(^|[^a-z])(error|fail(ed|ure)?|✗|✘)([^a-z]|$)' "$1" \
    || tail -n 1 "$1"
}

fail=0
stage=0
failures=()
for r in "$@"; do
  status_file="$logs/$r.rc"
  error=""
  if wait "${pids[stage]}" && [[ -f "$status_file" && ! -L "$status_file" && ! "$status_file" -ot "$logs/started" ]] \
    && IFS= read -r status <"$status_file" \
    && [[ "$status" =~ ^(0|[1-9][0-9]{0,2})\ ([0-9]+\.[0-9])$ ]] \
    && (( BASH_REMATCH[1] <= 255 )) && cmp -s "$status_file" <(printf '%s\n' "$status"); then
    rc="${BASH_REMATCH[1]}" secs="${BASH_REMATCH[2]}s"
  else
    rc=1 secs="?"
    error="could not write or read a valid stage status for this run"
  fi
  stage=$((stage + 1))
  if [[ "$rc" == 0 ]]; then
    # ci-scope / ci-skip skipped a step: surface the reason in the table, a skip is not a silent pass.
    note=""
    if grep -q '^ci-scope: skip' "$logs/$r.log"; then
      note="  (skipped: diff out of scope)"
    elif skip_line="$(grep -m1 '^ci-skip: ' "$logs/$r.log")"; then
      note="  (skipped: ${skip_line#ci-skip: })"
    fi
    table+="$(printf 'ok    %-22s %7s%s' "$r" "$secs" "$note")"$'\n'
  else
    fail=1
    table+="$(printf 'FAIL  %-22s %7s' "$r" "$secs")"$'\n'
    echo "----- $r (last 40 lines) -----" >&2
    tail -n 40 "$logs/$r.log" >&2
    error="${error:-$(first_error "$logs/$r.log")}"
    echo "first error: $error" >&2
    echo "rerun: just $r" >&2
    failures+=("- **$r**: $error — rerun \`just $r\`")
  fi
done

total="$(LC_ALL=C printf '%.1f' "$(bc <<<"$(now) - $start")")"
printf '%stotal %ss\n' "$table" "$total"

if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
  {
    echo '```'
    printf '%stotal %ss\n' "$table" "$total"
    echo '```'
    for line in ${failures[@]+"${failures[@]}"}; do
      printf '%s\n' "$line"
    done
  } >>"$GITHUB_STEP_SUMMARY"
fi
exit "$fail"
