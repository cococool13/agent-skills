#!/usr/bin/env bash
# ci-sync [--check] [repo-dir]   (default: current repo)
# Copies the canonical kit (bin/, hooks/, oxlint/) into <repo>/.ci/ so every clone,
# cloud agent and the box has the same scripts. --check only reports drift
# and exits 1 when the vendored copy differs. Never deletes files.
# Compares against origin/main as last fetched; `git -C ~/.agents fetch` first for the newest kit.
set -euo pipefail
# The kit is agent-config's origin/main, never the branch ~/.agents has checked out:
# that checkout is live for every agent and can sit on a branch without ci/.
# CI_KIT=<dir> overrides (kit development, tests).
kit="${CI_KIT:-}"
if [[ -z "$kit" ]]; then
  src="${CI_KIT_REPO:-$HOME/.agents}"
  sha="$(git -C "$src" rev-parse -q --verify 'origin/main^{commit}')" || { echo "ci-sync: no origin/main in $src (set CI_KIT)" >&2; exit 2; }
  out="${XDG_CACHE_HOME:-$HOME/.cache}/ci/kit-main/$sha"
  if [[ ! -d "$out" ]]; then
    # Extract beside the target, then rename: a stopped or parallel run never leaves half a kit.
    mkdir -p "${out%/*}"
    part="$(mktemp -d "$out.XXXXXX")"
    git -C "$src" archive "$sha" ci | tar -x -C "$part"
    mv "$part" "$out"
  fi
  kit="$out/ci"
fi
check=0
[[ "${1:-}" == "--check" ]] && { check=1; shift; }
repo="$(git -C "${1:-.}" rev-parse --show-toplevel)"
[[ -d "$kit/bin" ]] || { echo "ci-sync: no kit at $kit (set CI_KIT)" >&2; exit 2; }

if [[ "$check" == 1 ]]; then
  drift=0
  for d in bin hooks oxlint; do
    diff -rq "$kit/$d" "$repo/.ci/$d" || drift=1
  done
  [[ "$drift" == 0 ]] && echo "ci-sync: .ci matches $kit" || echo "ci-sync: drift; run ci-sync $repo" >&2
  exit "$drift"
fi

mkdir -p "$repo/.ci"
for d in bin hooks oxlint; do
  mkdir -p "$repo/.ci/$d"
  cp -p "$kit/$d/"* "$repo/.ci/$d/"
done
echo "ci-sync: copied $kit/{bin,hooks,oxlint} into $repo/.ci"
