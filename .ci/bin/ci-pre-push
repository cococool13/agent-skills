#!/usr/bin/env bash
# lefthook pre-push entry (use_stdin: true). Runs ci-check on every branch tip
# being pushed. Tags, notes and deletions are skipped.
set -euo pipefail
# Git exports GIT_DIR (and friends) to hooks run from a linked worktree. Left set, every
# `git -C <another repo>` in a recipe reads this repo instead: ci-taste failed with
# "Needed a single revision" looking for Design Guard's tag here (2026-11-18).
read -ra git_env <<<"$(git rev-parse --local-env-vars | tr '\n' ' ')"
unset "${git_env[@]}"
here="$(cd "$(dirname "$0")" && pwd)"
checked=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [[ -n "${local_sha:-}" && ! "$local_sha" =~ ^0+$ ]] || continue
  [[ "$local_ref" == refs/heads/* ]] || continue
  "$here/ci-check" "$local_sha"
  checked=1
done
[[ "$checked" == 1 ]] || echo "ci: nothing to check in this push"
